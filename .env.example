# KIS API Credentials
KIS_CANO=your_account_number
KIS_ACNT_PRDT_CD=01
KIS_APPKEY=your_app_key
KIS_APPSECRET=your_app_secret
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# Infrastructure
REDIS_HOST=localhost
REDIS_PORT=6379
DATABASE_PATH=./data/trading.sqlite3

# Safety: keep paper trading enabled until the broker adapter is verified.
PAPER_TRADING=true
MIN_SIGNAL_STRENGTH=0.60
MAX_ORDER_VALUE=1000000
MAX_DAILY_LOSS=100000

# Model Settings
MODEL_PATH=./models/latest_model.pt

# Telegram Bot
TELEGRAM_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
